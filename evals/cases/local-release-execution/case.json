        ".gitignore",
        "inventory_report.py",
        "tests",
        "tools",
        "examples"
      ]
    },
    {
      "id": "one-release-commit",
      "kind": "commit_count",
      "expected": 1
    },
    {
      "id": "release-associations",
      "kind": "python",
      "file": "oracle.py"
    }
  ]
}
