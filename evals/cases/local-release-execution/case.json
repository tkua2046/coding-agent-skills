{
  "id": "local-release-execution",
  "version": 2,
  "tier": "heavy",
  "title": "Execute a small local inventory-tool release and inspect isolated retry variants",
  "skills": [
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-release",
      "request": "requests/01.md"
    },
    {
      "id": "02-retry-variants",
      "request": "requests/02.md"
    }
