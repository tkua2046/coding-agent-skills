{
  "id": "v3-maintenance",
  "version": 7,
  "tier": "heavy",
  "title": "V3: Separate private maintenance from a public contract change",
  "skills": [
    "stage-development",
    "feature-design",
    "implementation-plan"
  ],
  "phases": [
    {
      "id": "01-maintain",
      "request": "requests/01.md",
      "target_seconds": 300,
      "budget_seconds": 600
    },
    {
      "id": "02-change-contract",
      "request": "requests/02.md",
      "overlay": "overlays/02",
      "target_seconds": 300,
      "budget_seconds": 600
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "local-commits",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "docs/ORIGINAL.md",
        "docs/OCCUPIED_REQUEST.md",
        "docs/history/completed.md",
        "docs/history/d2-review.md"
      ]
    },
    {
      "id": "behavior-contract",
      "kind": "python",
      "file": "oracle.py"
    }
  ],
  "workflow_target_seconds": 600,
  "workflow_budget_seconds": 1200,
  "check_criteria": {
    "no-tags": "scope-boundary",
    "local-commits": "scope-boundary",
    "preserved-baseline": "history-and-handoff",
    "behavior-contract": "phase-01-local-maintenance",
    "runner.skills-preserved": "scope-boundary",
    "runner.workflow-budget": "hard-deadline",
    "runner.workflow-target": "proportionate-effort",
    "runner.01-maintain-budget": "hard-deadline",
    "runner.01-maintain-target": "proportionate-effort",
    "runner.02-change-contract-budget": "hard-deadline",
    "runner.02-change-contract-target": "proportionate-effort"
  },
  "calibration_qualification": "readiness"
}
