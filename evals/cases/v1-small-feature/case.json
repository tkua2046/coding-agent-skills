{
  "id": "v1-small-feature",
  "version": 8,
  "tier": "heavy",
  "title": "V1: Plan occupied cells in an existing navigator",
  "skills": [
    "feature-design",
    "implementation-plan"
  ],
  "phases": [
    {
      "id": "01-plan",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "local-commits",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "navigator.py",
        "tests",
        "docs/ORIGINAL.md",
        "docs/OCCUPIED_REQUEST.md",
        "docs/history/completed.md"
      ]
    }
  ],
  "reading_probe": {
    "documents": [
      "docs/DESIGN.md",
      "docs/PLAN.md"
    ],
    "questions": [
      "What behavior or outcome is changing, and what remains important to preserve?",
      "What is the main technical decision and its practical consequence or tradeoff?",
      "What is the next uncompleted implementation outcome, its dependency, and one decisive acceptance example?"
    ]
  },
  "workflow_target_seconds": 300,
  "workflow_budget_seconds": 600,
  "check_criteria": {
    "no-tags": "scope-boundary",
    "local-commits": "scope-boundary",
    "preserved-baseline": "preserve-intent",
    "runner.skills-preserved": "scope-boundary",
    "runner.workflow-budget": "hard-deadline",
    "runner.workflow-target": "proportionate-effort"
  },
  "calibration_qualification": "readiness"
}
