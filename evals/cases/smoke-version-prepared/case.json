{
  "id": "smoke-version-prepared",
  "version": 2,
  "tier": "smoke",
  "title": "Recognize already prepared version metadata without another bump",
  "skills": [
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-operation",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commit",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "source-preserved",
      "kind": "unchanged",
      "paths": [
        "AGENTS.md",
        "inventory_report.py",
        "tests/test_inventory_report.py",
        "README.md",
        "examples/stock.csv",
        "DEVNOTES.md"
      ]
    },
    {
      "id": "behavior",
      "kind": "python",
      "file": "oracle.py"
    }
  ],
  "workflow_target_seconds": 300,
  "workflow_budget_seconds": 600,
  "calibration_qualification": "readiness",
  "check_criteria": {
    "no-tags": "scope",
    "no-commit": "scope",
    "source-preserved": "scope",
    "behavior": "version-notes",
    "runner.skills-preserved": "scope",
    "runner.workflow-budget": "hard-deadline",
    "runner.workflow-target": "proportionate-effort"
  }
}
