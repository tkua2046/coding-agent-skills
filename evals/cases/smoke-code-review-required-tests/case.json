{
  "id": "smoke-code-review-required-tests",
  "version": 1,
  "tier": "smoke",
  "title": "Review correct code under an explicit unmet regression policy",
  "skills": [
    "stage-development"
  ],
  "phases": [
    {
      "id": "01-operation",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commit",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "source-preserved",
      "kind": "unchanged",
      "paths": [
        "AGENTS.md",
        "session.py",
        "REQUEST.md",
        "tests/test_session.py"
      ]
    }
  ],
  "workflow_target_seconds": 300,
  "workflow_budget_seconds": 600,
  "check_criteria": {
    "no-tags": "scope",
    "no-commit": "scope",
    "source-preserved": "scope",
    "runner.skills-preserved": "scope",
    "runner.workflow-target": "effort",
    "runner.workflow-budget": "scope"
  }
}
