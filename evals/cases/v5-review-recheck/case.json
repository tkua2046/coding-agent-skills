{
  "id": "v5-review-recheck",
  "version": 1,
  "tier": "heavy",
  "title": "V5: Recheck an incomplete then corrected document fix",
  "skills": [
    "feature-design"
  ],
  "phases": [
    {
      "id": "01-recheck",
      "request": "requests/01.md"
    },
    {
      "id": "02-recheck-correction",
      "request": "requests/02.md",
      "overlay": "overlays/02"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "local-commits",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "docs/ORIGINAL.md",
        "docs/history"
      ]
    }
  ]
}
