{
  "id": "smoke-setup-coverage",
  "version": 4,
  "tier": "smoke",
  "title": "Integrate application coverage into the existing check command",
  "skills": [
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-operation",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commit",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "source-preserved",
      "kind": "unchanged",
      "paths": [
        "AGENTS.md",
        "inventory.py",
        "qa/check_inventory.py",
        "quality.ini",
        ".coveragerc",
        "examples/stock.csv",
        "DEVNOTES.md"
      ]
    },
    {
      "id": "behavior",
      "kind": "python",
      "file": "oracle.py"
    }
  ]
}
