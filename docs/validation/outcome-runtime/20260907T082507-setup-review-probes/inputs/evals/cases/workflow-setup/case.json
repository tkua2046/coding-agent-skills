{
  "id": "workflow-setup",
  "version": 1,
  "tier": "heavy",
  "title": "Adapt inventory workflow, then prepare its local PR draft",
  "skills": [
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-setup",
      "request": "requests/01.md"
    },
    {
      "id": "02-prepare-pr",
      "request": "requests/02.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "local-commits",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "inventory.py",
        "qa",
        "examples",
        "hooks",
        "quality.ini",
        ".coveragerc",
        "VERSION"
      ]
    },
    {
      "id": "installed-gate-contract",
      "kind": "python",
      "file": "oracle.py"
    }
  ],
  "hook": "hooks/pre-commit"
}
