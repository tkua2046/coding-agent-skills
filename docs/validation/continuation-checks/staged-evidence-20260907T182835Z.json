  "method": "Use existing report SHA-256 maps; force-stage precisely the declared originals/reports to overcome nested fixture ignore rules; compare actual Git blob IDs with independently computed blob IDs. No original map is rewritten or copied into this record.",
  "procedure_source": "\"\"\"One-off delivery verification, using existing report identities; no new framework.\"\"\"\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nimport hashlib\nimport json\nimport subprocess\nimport tempfile\nfrom tools import canary\n\nroot = Path.cwd().resolve()\nreports = sorted((root / 'docs/validation/canary').glob('*/report.json'))\ndeclared = {}\nreport_ids = {}\nfor path in reports:\n    raw = path.read_bytes()\n    report_ids[str(path.relative_to(root))] = hashlib.sha256(raw).hexdigest()\n    declared[str(path.relative_to(root))] = hashlib.sha256(raw).hexdigest()\n    for name, expected in json.loads(raw).get('evidence', {}).items():\n        file = canary.local(path.parent, name)\n        rel = str(file.relative_to(root))\n        assert rel not in declared or declared[rel] == expected, rel\n        declared[rel] = expected\nerrors = []\nblobs = {}\nassert subprocess.check_output(['git', 'rev-parse', '--show-object-format'], text=True).strip() == 'sha1'\nfor rel, expected in declared.items():\n    path = root / rel\n    if not path.is_file():\n        errors.append({'path': rel, 'reason': 'missing original'})\n        continue\n    data = path.read_bytes()\n    if hashlib.sha256(data).hexdigest() != expected:\n        errors.append({'path': rel, 'reason': 'original hash mismatch'})\n    blobs[rel] = hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\\0' + data).hexdigest()\nif errors:\n    raise RuntimeError(errors[:10])\nwith tempfile.NamedTemporaryFile() as paths:\n    paths.write(b''.join(name.encode() + b'\\0' for name in declared))\n    paths.flush()\n    subprocess.run(['git', 'add', '--force', '--pathspec-from-file=' + paths.name, '--pathspec-file-nul'], check=True)\nindex = {}\nfor entry in subprocess.check_output(['git', 'ls-files', '--stage', '-z']).split(b'\\0'):\n    if not entry:\n        continue\n    metadata, path = entry.split(b'\\t', 1)\n    mode, blob, stage = metadata.decode().split()\n    assert stage == '0', path\n    index[path.decode()] = blob\nfor rel, expected in blobs.items():\n    if index.get(rel) != expected:\n        errors.append({'path': rel, 'reason': 'staged Git blob differs from original bytes'})\nrecord = {\n    'purpose': 'Verify each completed canary report and every declared original in both live files and staged Git; no skill-quality claim.',\n    'created_at': datetime.now(timezone.utc).isoformat(),\n    'status': 'pass' if not errors else 'fail',\n    'completed_reports': len(reports), 'verified_files': len(declared),\n    'reports': report_ids,\n    'method': 'Use existing report SHA-256 maps; force-stage precisely the declared originals/reports to overcome nested fixture ignore rules; compare actual Git blob IDs with independently computed blob IDs. No original map is rewritten or copied into this record.',\n    'procedure_source': Path(__file__).read_text(),\n    'errors': errors,\n}\nout = root / 'docs/validation/continuation-checks' / ('staged-evidence-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '.json')\ncanary.save(out, record)\nprint(out.relative_to(root), record['status'], len(declared), 'files from', len(reports), 'reports')\nraise SystemExit(bool(errors))\n",
  "errors": []
}
