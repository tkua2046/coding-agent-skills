diff --git a/tests/test_counter.py b/tests/test_counter.py
index 0c4256a..06cba3f 100644
--- a/tests/test_counter.py
+++ b/tests/test_counter.py
@@ -19,0 +20,24 @@ class CounterTests(unittest.TestCase):
+
+    def test_invalid_steps_preserve_value(self):
+        for step in (0, -1, True, False, 1.0, 0.5, "2", None, [], {}, object()):
+            with self.subTest(step=step):
+                counter = Counter(-7)
+                with self.assertRaises(ValueError):
+                    counter.add(step)
+                self.assertEqual(counter.value, -7)
+                self.assertEqual(counter.add(), -6)
+
+    def test_integer_initial_values_and_large_steps(self):
+        for initial in (-10, 0, 10, 10**100):
+            with self.subTest(initial=initial):
+                counter = Counter(initial)
+                self.assertEqual(counter.add(step=10**100), initial + 10**100)
+                self.assertEqual(counter.value, initial + 10**100)
+
+    def test_integer_subclass_step(self):
+        class Step(int):
+            pass
+
+        counter = Counter()
+        self.assertEqual(counter.add(Step(2)), 2)
+        self.assertEqual(counter.value, 2)
