{
  "id": "existing-intake",
  "version": 1,
  "tier": "heavy",
  "title": "Existing-project intake with a failing legacy expectation",
  "skills": [
    "feature-design"
  ],
  "phases": [
    {
      "id": "01-intake",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "local-commits",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "FEATURE.txt",
        "formatter.py",
        "tests",
        "README.md"
      ]
    }
  ]
}
