{
  "id": "smoke-setup-evidence",
  "version": 2,
  "tier": "smoke",
  "title": "Distinguish listed tests from an executed development gate",
  "skills": [
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-operation",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commit",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "source-preserved",
      "kind": "unchanged",
      "paths": [
        "AGENTS.md",
        "catalog.py",
        "tests/test_catalog.py",
        "DEVNOTES.md",
        "README.md",
        "previous-command.json"
      ]
    }
  ]
}
