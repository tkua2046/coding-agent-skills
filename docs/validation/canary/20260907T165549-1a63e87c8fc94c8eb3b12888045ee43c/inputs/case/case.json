{
  "id": "smoke-transfer-pr",
  "version": 1,
  "tier": "smoke",
  "title": "A changed current check cannot inherit a previous green result",
  "skills": [
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-operation",
      "request": "requests/01.md"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commit",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "source-preserved",
      "kind": "unchanged",
      "paths": [
        "AGENTS.md",
        "serializer.py",
        "tests/test_serializer.py",
        "CHANGE.md",
        "DEVNOTES.md",
        "previous-report.md",
        "CHANGELOG.md"
      ]
    }
  ]
}
