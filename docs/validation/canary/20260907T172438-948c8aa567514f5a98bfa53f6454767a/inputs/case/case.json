{
  "id": "v2-scope-extension",
  "version": 3,
  "tier": "heavy",
  "title": "V2: Confirm YAML pose and large obstacle input",
  "skills": [
    "feature-design",
    "implementation-plan"
  ],
  "phases": [
    {
      "id": "01-plan",
      "request": "requests/01.md"
    },
    {
      "id": "02-extend",
      "request": "requests/02.md",
      "overlay": "overlays/02"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "local-commits",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "navigator.py",
        "tests",
        "docs/ORIGINAL.md",
        "docs/OCCUPIED_REQUEST.md",
        "docs/history/completed.md"
      ]
    }
  ],
  "reading_probe": {
    "documents": [
      "docs/DESIGN.md",
      "docs/PLAN.md"
    ],
    "questions": [
      "What behavior or outcome is changing, and what remains important to preserve?",
      "What is the main technical decision and its practical consequence or tradeoff?",
      "What is the next uncompleted implementation outcome, its dependency, and one decisive acceptance example?"
    ]
  }
}
