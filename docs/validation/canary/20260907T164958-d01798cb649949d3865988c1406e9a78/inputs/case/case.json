{
  "id": "smoke-review-ready",
  "version": 1,
  "tier": "smoke",
  "title": "Accept sufficient design and plan with a useful short verdict",
  "skills": [
    "feature-design",
    "implementation-plan"
  ],
  "phases": [
    {
      "id": "01-operation",
      "request": "requests/01.md"
    }
  ],
  "checks": [
