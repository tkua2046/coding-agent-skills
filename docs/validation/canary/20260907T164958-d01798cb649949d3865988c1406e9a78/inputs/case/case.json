      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commit",
      "kind": "commit_count",
      "expected": 0
    },
    {
      "id": "source-preserved",
      "kind": "unchanged",
      "paths": [
        "AGENTS.md",
        "REQUEST.md",
        "docs/DESIGN.md",
        "docs/PLAN.md"
      ]
    }
  ]
}
