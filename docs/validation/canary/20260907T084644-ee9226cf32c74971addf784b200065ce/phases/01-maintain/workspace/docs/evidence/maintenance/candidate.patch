--- a/navigator.py
+++ b/navigator.py
@@ -1,7 +1,7 @@
 DIRECTIONS = ((0, 1), (1, 0), (0, -1), (-1, 0))
 
 
-def _target(pose):
+def _next_pose(pose):
     x, y, heading = pose
     dx, dy = DIRECTIONS[heading]
     return x + dx, y + dy, heading
@@ -13,7 +13,7 @@ def run(pose, commands, occupied=()):
     for command in commands:
         x, y, heading = pose
         if command == "F":
-            candidate = _target(pose)
+            candidate = _next_pose(pose)
             if candidate[:2] in occupied:
                 outcomes.append(False)
