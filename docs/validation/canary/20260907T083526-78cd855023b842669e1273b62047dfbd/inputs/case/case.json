{
  "id": "bounded-investigation",
  "version": 1,
  "tier": "heavy",
  "title": "Resolve a performance uncertainty before selecting architecture",
  "skills": [
    "feature-design"
  ],
  "phases": [
    {
      "id": "01-investigate",
      "request": "requests/01.md"
    }
  ],
  "workflow_budget_seconds": 300,
  "reading_probe": {
    "documents": [
      "docs/INVESTIGATION.md"
    ],
    "questions": [
      "What was investigated and what did the observed evidence establish?",
      "What is the next recommended action and what remains uncertain?"
    ]
  },
  "checks": [
    {
      "id": "preserve-application",
      "kind": "unchanged",
      "paths": [
        "report.py",
        "tests",
        "README.md"
      ]
    },
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "no-commits",
      "kind": "commit_count",
      "expected": 0
    }
  ]
}
