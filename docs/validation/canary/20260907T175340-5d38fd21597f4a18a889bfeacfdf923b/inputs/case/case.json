{
  "id": "v6-execution-handoff",
  "version": 2,
  "tier": "heavy",
  "title": "V6: Execute, independently recheck, resume and deliver locally",
  "skills": [
    "stage-development",
    "dev-workflow"
  ],
  "phases": [
    {
      "id": "01-execute",
      "request": "requests/01.md"
    },
    {
      "id": "02-review",
      "request": "requests/02.md",
      "overlay": "overlays/02"
    },
    {
      "id": "03-fix",
      "request": "requests/03.md"
    },
    {
      "id": "04-recheck",
      "request": "requests/04.md"
    },
    {
      "id": "05-resume",
      "request": "requests/05.md"
    },
    {
      "id": "06-accepted-delivery",
      "request": "requests/06.md",
      "overlay": "overlays/06"
    }
  ],
  "checks": [
    {
      "id": "no-tags",
      "kind": "no_tags"
    },
    {
      "id": "accepted-delivery",
      "kind": "phase_delivery",
      "review_phase": "04-recheck",
      "delivery_phase": "06-accepted-delivery",
      "paths": [
        "counter.py",
        "tests",
        "README.md",
        "CHANGELOG.md",
        "FEATURE.md",
        "DEVNOTES.md",
        "hooks",
        "VERSION",
        "AGENTS.md"
      ]
    },
    {
      "id": "preserved-baseline",
      "kind": "unchanged",
      "paths": [
        "FEATURE.md",
        "hooks/pre-commit",
        "VERSION"
      ]
    },
    {
      "id": "behavior-contract",
      "kind": "python",
      "file": "oracle.py"
    }
  ],
  "hook": "hooks/pre-commit"
}
